# Generated by scripts/update-tap.sh from fstormacq/pulse (packaging/homebrew); do not edit here.
cask "pulse" do
  version "__VERSION__"
  sha256 "__SHA256_APP__"

  url "https://github.com/fstormacq/pulse/releases/download/v#{version}/Pulse-#{version}.zip"
  name "Pulse"
  desc "Menu bar temperatures and fan control for Apple silicon Macs"
  homepage "https://github.com/fstormacq/pulse"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on macos: :tahoe

  app "Pulse.app"
  binary "#{appdir}/Pulse.app/Contents/Helpers/pulse"

  # Pulse is signed ad hoc, not notarized: without this, Gatekeeper blocks it
  # at the first launch and again after every upgrade.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/Pulse.app"]
  end

  # Quitting lets Homebrew reopen Pulse after an upgrade. The fan control service
  # is left running: Pulse updates it on launch, after asking for your password.
  uninstall quit: "com.stormacq.pulse"

  zap launchctl: "com.stormacq.pulse.daemon",
      delete:    [
        "/etc/pulse",
        "/Library/LaunchDaemons/com.stormacq.pulse.daemon.plist",
        "/Library/PrivilegedHelperTools/com.stormacq.pulse.daemon",
      ],
      trash:     "~/Library/Preferences/com.stormacq.pulse.plist"

  caveats <<~EOS
    Open Pulse from Applications, then choose Install… to enable fan control
    (it asks for your password once). Upgrades update the service by themselves.

    To remove the fan control service with the app:
      sudo pulse daemon uninstall
      brew uninstall --cask fstormacq/tap/pulse
  EOS
end
