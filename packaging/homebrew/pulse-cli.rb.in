# Generated by scripts/update-tap.sh from fstormacq/pulse (packaging/homebrew); do not edit here.
class PulseCli < Formula
  desc "Temperatures and fan control for Apple silicon Macs, from the command-line"
  homepage "https://github.com/fstormacq/pulse"
  url "https://github.com/fstormacq/pulse/releases/download/v__VERSION__/pulse-cli-__VERSION__-arm64.tar.gz"
  version "__VERSION__"
  sha256 "__SHA256_CLI__"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on macos: :sonoma

  def install
    # pulse looks for pulsed next to itself when installing the daemon.
    bin.install "pulse", "pulsed"
  end

  def caveats
    <<~EOS
      Install the fan control service once:
        sudo pulse daemon install
      After `brew upgrade pulse-cli`, the next pulse command updates the service
      (it asks for your password).

      The Pulse app (brew install --cask pulse) includes this CLI: install one or the other.
    EOS
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/pulse --version").strip
  end
end
